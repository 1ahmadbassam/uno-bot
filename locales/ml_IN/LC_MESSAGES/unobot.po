#: actions.py:51
#, python-brace-format
msgid "Time ran out to choose a color! Color automatically set to {color}."
msgstr ""
"നിറം തിരഞ്ഞെടുക്കാനുള്ള സമയം കഴിഞ്ഞു! നിറം സ്വയമേവ {color} ആയി സജ്ജീകരിച്ചു."

#: actions.py:90
#, python-brace-format
msgid ""
"Waiting time to skip this player has been reduced to {time} seconds.\n"
"Next player: {name}"
msgstr ""
"ഈ കളിക്കാരനെ ഒഴിവാക്കാനുള്ള കാത്തിരിപ്പ് സമയം {time} സെക്കൻഡായി കുറച്ചു.\n"
"അടുത്ത കളിക്കാരൻ: {name}"

#: actions.py:108
#, python-brace-format
msgid ""
"{name1} ran out of time and has been removed from the game!\n"
"Next player: {name2}"
msgstr ""
"{name1}-ന്റെ സമയം കഴിഞ്ഞു, ഗെയിമിൽ നിന്ന് നീക്കം ചെയ്തു!\n"
"അടുത്ത കളിക്കാരൻ: {name2}"

#: actions.py:123
#, python-brace-format
msgid ""
"{name} ran out of time and has been removed from the game!\n"
"The game ended."
msgstr ""
"{name}-ന്റെ സമയം കഴിഞ്ഞു, ഗെയിമിൽ നിന്ന് നീക്കം ചെയ്തു!\n"
"ഗെയിം അവസാനിച്ചു."

#: actions.py:143 actions.py:183
#, python-brace-format
msgid "{name} won!"
msgstr "{name} ജയിച്ചു!"

#: actions.py:158 bot.py:197 bot.py:290 bot.py:374 bot.py:726
msgid "Game ended!"
msgstr "കളി അവസാനിച്ചു!"

#: actions.py:208
msgid "The game ended without a winner."
msgstr "വിജയിയില്ലാതെ ഗെയിം അവസാനിച്ചു."

#: actions.py:228
msgid ""
"The player facing the draw penalty left the game, so it was cancelled."
msgstr ""
"പിഴ കാർഡുകൾ എടുക്കേണ്ടിയിരുന്ന കളിക്കാരൻ ഗെയിം വിട്ടതിനാൽ പിഴ റദ്ദാക്കി."

#: actions.py:254 actions.py:362
msgid ""
"The player who played the +4 left the game, so its penalty is cancelled."
msgstr "+4 കളിച്ച കളിക്കാരൻ ഗെയിം വിട്ടതിനാൽ അതിന്റെ പിഴ റദ്ദാക്കി."

#: actions.py:301
#, python-brace-format
msgid "Winning card was Wild! Color set to {color}."
msgstr "വിജയിച്ച കാർഡ് വൈൽഡ് ആയിരുന്നു! നിറം {color} ആയി സജ്ജീകരിച്ചു."

#: actions.py:314
msgid "Please choose a color"
msgstr "നിറം തിരഞ്ഞെടുക്കുക."

#: actions.py:329 actions.py:384 actions.py:400
msgid "There are no more cards in the deck."
msgstr "ഡെക്കിൽ കൂടുതൽ കാർഡുകളൊന്നുമില്ല."

#: actions.py:376
#, python-brace-format
msgid "Bluff called! Giving 4 cards to {name}"
msgstr "ബ്ലഫ് വിളിച്ചു! {name}  ന് 4 കാർഡുകൾ നൽകുന്നു."

#: actions.py:392
#, python-brace-format
msgid "{name1} didn't bluff! Giving 6 cards to {name2}"
msgstr "{name1} bluff ചെയ്തില്ല. {name2} ന് 6 കാർഡ് നല്‍കുന്നു ."

#: bot.py:136
msgid ""
"Send this command in a group to be notified when a new game is started "
"there."
msgstr ""
"ഒരു ഗ്രൂപ്പിൽ പുതിയ ഗെയിം ആരംഭിക്കുമ്പോൾ അറിയിപ്പ് ലഭിക്കാൻ ഈ കമാൻഡ് ആ "
"ഗ്രൂപ്പിൽ അയയ്ക്കുക."

#: bot.py:159
#, python-brace-format
msgid "A new game has been started in {title}"
msgstr "{title}-ൽ ഒരു പുതിയ ഗെയിം ആരംഭിച്ചു"

#: bot.py:170
msgid ""
"Created a new game! Join the game with /join and start the game with /start"
msgstr ""
"പുതിയ ഗെയിം സൃഷ്ടിച്ചു! /join ഉപയോഗിച്ച് ഗെയിം ജോയിൻ ചെയ്തതിനു ശേഷം /start "
"ഉപയോഗിച്ച് ഗെയിം തുടങ്ങു."

#: bot.py:188 bot.py:543 bot.py:859 bot.py:889 bot.py:918 bot.py:948
msgid "There is no running game in this chat."
msgstr "ഈ ചാറ്റിൽ പ്രവർത്തിക്കുന്ന ഗെയിമുകളൊന്നുമില്ല."

#: bot.py:201 bot.py:343
msgid ""
"The game is not started yet. Join the game with /join and start the game "
"with /start"
msgstr ""
"ഗെയിം ഇതുവരെ ആരംഭിച്ചിട്ടില്ല. /join ഉപയോഗിച്ച് ചേരുക, /start ഉപയോഗിച്ച് "
"ഗെയിം ആരംഭിക്കുക"

#: bot.py:207 bot.py:406 bot.py:873 bot.py:902 bot.py:932 bot.py:963
#, python-brace-format
msgid "Only the game creator ({name}) and admin can do that."
msgstr ""
"ഗെയിം സൃഷ്ടിച്ചയാൾക്കും ({name}) അഡ്മിനുകൾക്കും മാത്രമേ അത് ചെയ്യാൻ കഴിയൂ."

#: bot.py:224
msgid "The lobby is closed"
msgstr "ലോബി അടച്ചു"

#: bot.py:228
msgid "The game is full."
msgstr "ഗെയിം നിറഞ്ഞു."

#: bot.py:233
msgid "You left this game, so you can't join it again."
msgstr "നിങ്ങൾ ഈ ഗെയിം വിട്ടതിനാൽ വീണ്ടും ചേരാൻ കഴിയില്ല."

#: bot.py:238 bot.py:336
msgid "No game is running at the moment. Create a new game with /new"
msgstr "ഒരു കളിയും ഇപ്പോൾ നടക്കുന്നില്ല /new  പുതിയ കളി സൃഷ്ടിക്കുക."

#: bot.py:244
msgid "You already joined the game. Start the game with /start"
msgstr ""
"നിങ്ങൾ ഇതിനകം ഗെയിമിൽ ചേർന്നു. /start വച്ച് ഗെയിം സ്റ്റാർട്ട് ചെയ്യൂ."

#: bot.py:250
msgid "There are not enough cards left in the deck for new players to join."
msgstr "പുതിയ കളിക്കാർക്ക് ചേരാൻ ഡെക്കിൽ ആവശ്യത്തിന് കാർഡുകൾ ബാക്കിയില്ല."

#: bot.py:256
msgid "Joined the game"
msgstr "ഗെയിമിൽ ചേർന്നു."

#: bot.py:269 bot.py:283
msgid "You are not playing in a game in this group."
msgstr "നിങ്ങൾ ഈ ഗ്രൂപ്പിൽ ഗെയിം കളിക്കുന്നില്ല."

#: bot.py:295 bot.py:382 bot.py:734
#, python-brace-format
msgid ""
"Player left while choosing a color! Color automatically set to {color}."
msgstr ""
"നിറം തിരഞ്ഞെടുക്കുന്നതിനിടെ ഒരു കളിക്കാരൻ പോയി! നിറം സ്വയമേവ {color} ആയി "
"സജ്ജീകരിച്ചു."

#: bot.py:304 bot.py:396
#, python-brace-format
msgid "Okay. Next Player: {name}"
msgstr "ശരി. അടുത്ത കളിക്കാരൻ: {name}"

#: bot.py:313
#, python-brace-format
msgid "{name} left the game before it started."
msgstr "ഗെയിം ആരംഭിക്കുന്നതിന് മുമ്പ് {name} ഗെയിം വിട്ടു."

#: bot.py:360
#, python-brace-format
msgid "Player {name} is not found in the current game."
msgstr "നിലവിലെ ഗെയിമിൽ {name} എന്ന കളിക്കാരനെ കണ്ടെത്തിയില്ല."

#: bot.py:366 bot.py:378
#, python-brace-format
msgid "{0} was kicked by {1}"
msgstr "{0}-നെ {1} പുറത്താക്കി"

#: bot.py:391
msgid "Please reply to the person you want to kick and type /kick again."
msgstr ""
"നിങ്ങൾ പുറത്താക്കാൻ ആഗ്രഹിക്കുന്നയാളുടെ സന്ദേശത്തിന് മറുപടി നൽകി വീണ്ടും "
"/kick ടൈപ്പ് ചെയ്യുക."

#: bot.py:422 bot.py:559 bot.py:613
msgid "This button is no longer valid."
msgstr "ഈ ബട്ടൺ ഇനി സാധുവല്ല."

#: bot.py:433
msgid "Please switch to the group you selected!"
msgstr "നിങ്ങൾ തിരഞ്ഞെടുത്ത ഗ്രൂപ്പിലേക്ക് മാറുക!"

#: bot.py:460
msgid "Game not found."
msgstr "ഗെയിം കണ്ടെത്താന് ആയില്ല."

#: bot.py:466
msgid "Back to last group"
msgstr "അവസാന ഗ്രൂപ്പിലേക്ക് മടങ്ങുന്നു."

#: bot.py:470
#, python-brace-format
msgid ""
"Selected group: {group}\n"
"<b>Make sure that you switch to the correct group!</b>"
msgstr ""
"തിരഞ്ഞെടുത്ത ഗ്രൂപ്പ്: {group}n\n"
"<b> നിങ്ങൾ ശരിയായ ഗ്രൂപ്പിലേക്ക് മാറുന്നുവെന്ന് ഉറപ്പാക്കുക! </ b>"

#: bot.py:564 bot.py:618
msgid "It's not your turn!"
msgstr "ഇത് നിങ്ങളുടെ ഊഴമല്ല!"

#: bot.py:574
#, python-brace-format
msgid "🎨 {name} chose {color}."
msgstr "🎨 {name} {color} തിരഞ്ഞെടുത്തു."

#: bot.py:589 bot.py:1164
#, python-brace-format
msgid "Starting color set to {color}!\n"
msgstr "തുടക്ക നിറം {color} ആയി സജ്ജീകരിച്ചു!\n"

#: bot.py:591 bot.py:1168
#, python-brace-format
msgid "Color set to {color}!\n"
msgstr "നിറം {color} ആയി സജ്ജീകരിച്ചു!\n"

#: bot.py:593 bot.py:645 bot.py:667 bot.py:692 bot.py:741 bot.py:1195
#, python-brace-format
msgid "Next player: {name}"
msgstr "അടുത്ത കളിക്കാരൻ : {name}"

#: bot.py:635
#, python-brace-format
msgid "📥 {name} drew {number} cards."
msgstr "📥 {name} {number} കാർഡുകൾ എടുത്തു."

#: bot.py:639
#, python-brace-format
msgid "📥 {name} drew a card."
msgstr "📥 {name} ഒരു കാർഡ് എടുത്തു."

#: bot.py:684
#, python-brace-format
msgid "⏭️ {name} passed."
msgstr "⏭️ {name} പാസ് ചെയ്തു."

#: bot.py:729
#, python-brace-format
msgid "Removing {name} from the game"
msgstr "ഗെയിമിൽ നിന്ന് {name} നീക്കംചെയ്യുന്നു."

#: bot.py:762
msgid "There is no game running in this chat. Create a new one with /new"
msgstr ""
"ഈ ചാറ്റിൽ ഒരു ഗെയിമും പ്രവർത്തിക്കുന്നില്ല. /new പുതിയത് ഉപയോഗിച്ച് "
"പുതിയൊരെണ്ണം തുടങ്ങൂ."

#: bot.py:767
msgid "The game has already started"
msgstr "ഗെയിം തുടങ്ങി കഴിഞ്ഞു."

#: bot.py:771
#, python-brace-format
msgid ""
"At least {minplayers} players must /join the game before you can start it"
msgstr ""
"ഗെയിം ആരംഭിക്കുന്നതിന് മുമ്പ് കുറഞ്ഞത് {minplayers} കളിക്കാർ /join ചെയ്യണം."

#: bot.py:785
msgid "There are not enough cards in the deck for this many players."
msgstr "ഇത്രയും കളിക്കാർക്ക് ഡെക്കിൽ ആവശ്യത്തിന് കാർഡുകളില്ല."

#: bot.py:791
#, python-brace-format
msgid ""
"First card is Wild!\n"
"First player: {name}\n"
"Please choose the starting color.\n"
"Use /close to stop people from joining the game.\n"
"Enable multi-translations with /enable_translations"
msgstr ""
"ആദ്യ കാർഡ് വൈൽഡ് ആണ്!\n"
"ആദ്യ കളിക്കാരൻ: {name}\n"
"തുടക്ക നിറം തിരഞ്ഞെടുക്കുക.\n"
"ആളുകൾ ഗെയിമിൽ ചേരുന്നത് തടയാൻ /close ഉപയോഗിക്കുക.\n"
"/enable_translations ഉപയോഗിച്ച് ബഹുഭാഷാ വിവർത്തനം ഓണാക്കുക"

#: bot.py:801
#, python-brace-format
msgid ""
"First player: {name}\n"
"Use /close to stop people from joining the game.\n"
"Enable multi-translations with /enable_translations"
msgstr ""
"ആദ്യ കളിക്കാരൻ: {name}\n"
"ആളുകളെ ഗെയിമിൽ ചേരുന്നത് തടയാൻ ഉപയോഗിക്കുക / close \n"
"/enable_translations ഉപയോഗിച്ച് ഒന്നിലധികം വിവർത്തനങ്ങൾ ഉപയോഗിക്കൂ."

#: bot.py:842
msgid "Please select the group you want to play in."
msgstr "നിങ്ങൾ കളിക്കാൻ ആഗ്രഹിക്കുന്ന ഗ്രൂപ്പ് തിരഞ്ഞെടുക്കുക."

#: bot.py:867
msgid "Closed the lobby. No more players can join this game."
msgstr "ലോബി അടച്ചു. കൂടുതൽ കളിക്കാർക്ക് ഈ ഗെയിമിൽ ചേരാനാവില്ല."

#: bot.py:897
msgid "Opened the lobby. New players may /join the game."
msgstr "ലോബി തുറന്നു. പുതിയ കളിക്കാർക്ക്  ഗെയിം കളിക്കാൻ /join."

#: bot.py:926
msgid "Enabled multi-translations. Disable with /disable_translations"
msgstr ""
"ഭാഷ വിവർത്തനങ്ങൾ  ഉപയോഗിക്കുന്നു. വിവർത്തനങ്ങൾ  ഒഴിവാക്കാൻ "
"/disable_translations ഉപയോഗിക്കുക."

#: bot.py:956
msgid ""
"Disabled multi-translations. Enable them again with /enable_translations"
msgstr ""
"മറ്റ് ഭാഷ വിവർത്തനങ്ങൾ പ്രവർത്തനരഹിതമാക്കി. വിവർത്തനങ്ങൾ ഉപയോഗിക്കാൻ "
"/enable_translations."

#: bot.py:979
msgid "You are not playing in a game in this chat."
msgstr "നിങ്ങൾ ഈ ചാറ്റിൽ ഗെയിം കളിക്കുന്നില്ല."

#: bot.py:995
#, python-brace-format
msgid "Please wait {time} second"
msgid_plural "Please wait {time} seconds"
msgstr[0] "{time} സെക്കൻഡ് വെയിറ്റ് ചെയ്യൂ."
msgstr[1] "{time} സെക്കൻഡ് വെയിറ്റ് ചെയ്യൂ."

#: bot.py:1075
#, python-brace-format
msgid "Current game: {game}"
msgstr "നിലവിലെ ഗെയിം: {game}"

#: bot.py:1127
#, python-brace-format
msgid "Gamemode changed to {mode}"
msgstr "ഗെയിം മോഡ് {mode} ആയി മാറ്റി"

#: bot.py:1183
#, python-brace-format
msgid "{name}, please choose a color:"
msgstr "{name}, ഒരു നിറം തിരഞ്ഞെടുക്കുക:"

#: bot.py:1234
#, python-brace-format
msgid "Waiting time for {name} has been reset to {time} seconds"
msgstr "{name} നു വേണ്ടി കാതിരിക്കാനുള്ള സമയം {time} ലേക്ക് റീസെറ്റ് ചെയ്തു."

#: results.py:39
msgid "Choose Color"
msgstr "നിറം തിരഞ്ഞെടുക്കുക."

